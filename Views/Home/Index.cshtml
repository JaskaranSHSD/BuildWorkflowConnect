@{ Layout = null; ViewData["Title"] = "API Tester"; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BuildWorkflow Connect</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{--bg:#ffffff;--bg2:#f8f9fa;--bg3:#f1f3f4;--bg4:#e8eaed;--line:#dadce0;--line2:#c6c9ce;--text:#202124;--muted:#5f6368;--dim:#80868b;--accent:#1a73e8;--accent2:#1967d2;--green:#188038;--red:#d93025;--amber:#f9ab00;--purple:#9334e6;--radius:8px;--radius-sm:6px;--shadow:0 1px 2px rgba(0,0,0,.1),0 1px 3px 1px rgba(0,0,0,.05);--font:'Roboto','Inter',system-ui,-apple-system,Segoe UI,Arial,sans-serif;--mono:'Roboto Mono','JetBrains Mono',ui-monospace,Consolas,monospace;color-scheme:light}
  *{box-sizing:border-box} html,body{margin:0;padding:0;height:100%;background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px}
  body{display:flex;flex-direction:column;overflow:hidden}
  button{font-family:inherit;cursor:pointer;border:0;background:transparent;color:inherit}
  input,textarea,select{font-family:inherit;font-size:14px;color:var(--text);background:var(--bg3);border:1px solid var(--line);border-radius:var(--radius-sm);padding:8px 10px;outline:none}
  input:focus,textarea:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(91,140,255,.15)}
  a{color:var(--accent)} ::-webkit-scrollbar{width:10px;height:10px} ::-webkit-scrollbar-thumb{background:var(--line2);border-radius:8px} ::-webkit-scrollbar-track{background:transparent}
  .topbar{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--bg2);border-bottom:1px solid var(--line);flex-shrink:0}
  .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;letter-spacing:-.01em} .logo-mark{width:26px;height:26px;display:block;flex:0 0 auto;filter:drop-shadow(0 1px 2px rgba(0,0,0,.12))} .logo-text{line-height:1.1} .logo-strong{color:var(--accent)}
  .spacer{flex:1} .env-select{min-width:180px}
  .btn{padding:7px 14px;border-radius:var(--radius-sm);font-weight:500;transition:.15s;background:var(--bg3);border:1px solid var(--line)}
  .btn:hover{background:var(--bg4);border-color:var(--line2)} .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff} .btn.primary:hover{background:var(--accent2)}
  .btn.ghost{background:transparent;border-color:transparent} .btn.ghost:hover{background:var(--bg3)} .btn.danger{color:var(--red)}
  .icon-btn{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;padding:0} .icon-btn:hover{background:var(--bg3)}
  .layout{display:grid;grid-template-columns:300px 1fr;flex:1;min-height:0}
  .sidebar{background:var(--bg2);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
  .side-tabs{display:flex;border-bottom:1px solid var(--line)} .side-tab{flex:1;padding:10px;font-weight:500;color:var(--muted);border-bottom:2px solid transparent} .side-tab.active{color:var(--text);border-color:var(--accent)}
  .side-body{flex:1;overflow:auto;padding:8px} .side-section{margin-bottom:12px} .side-head{display:flex;align-items:center;justify-content:space-between;padding:6px 8px;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em} .side-head .add{font-size:18px;line-height:1;color:var(--accent)}
  .group{border:1px solid var(--line);border-radius:var(--radius-sm);margin:6px 0;overflow:hidden} .group-head{display:flex;align-items:center;gap:6px;padding:8px 10px;background:var(--bg3);cursor:pointer}
  .group-head .chev{transition:.15s;font-size:11px;color:var(--muted)} .group.open .group-head .chev{transform:rotate(90deg)} .group-items{display:none;padding:4px} .group.open .group-items{display:block}
  .req-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:13px} .req-item:hover{background:var(--bg4)} .req-item.active{background:rgba(91,140,255,.15);color:var(--accent2)}
  .method-badge{font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;min-width:46px;text-align:center}
  .m-GET{background:rgba(63,208,134,.15);color:var(--green)} .m-POST{background:rgba(91,140,255,.15);color:var(--accent2)} .m-PUT{background:rgba(245,185,66,.15);color:var(--amber)} .m-PATCH{background:rgba(183,140,255,.15);color:var(--purple)} .m-DELETE{background:rgba(255,93,108,.15);color:var(--red)} .m-OPTIONS,.m-HEAD{background:rgba(138,145,168,.15);color:var(--muted)}
  .env-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer} .env-item:hover{background:var(--bg4)} .env-item.active{background:rgba(91,140,255,.15)}
  .main{display:flex;flex-direction:column;min-height:0}
  .req-bar{display:flex;gap:8px;padding:12px 16px;border-bottom:1px solid var(--line);align-items:center;flex-shrink:0}
  .method-sel{width:110px} .url-input{flex:1;font-family:var(--mono)} .send-btn{padding:9px 20px;background:var(--green);color:#0a1f12;border-radius:var(--radius-sm);font-weight:700} .send-btn:disabled{opacity:.5;cursor:wait} .send-btn:hover{filter:brightness(1.1)}
  .req-name{padding:4px 8px;min-width:150px}
  .tabs{display:flex;border-bottom:1px solid var(--line);padding:0 16px;gap:2px} .tab{padding:10px 14px;color:var(--muted);border-bottom:2px solid transparent;cursor:pointer} .tab.active{color:var(--text);border-color:var(--accent)}
  .tab-content{flex:1;overflow:auto;padding:16px;min-height:0;display:flex;flex-direction:column}
  .pane{display:none} .pane.active{display:block}
  .kv-table{width:100%;border-collapse:collapse} .kv-table th,.kv-table td{padding:6px 4px;text-align:left;vertical-align:middle} .kv-table th{color:var(--muted);font-size:12px;font-weight:500}
  .kv-input{width:100%;padding:6px 8px} .small-btn{padding:4px 8px;font-size:12px} .row-del{color:var(--red)}
  .body-area{width:100%;min-height:200px;font-family:var(--mono);font-size:13px;resize:vertical}
  .radio-group{display:flex;gap:12px;margin-bottom:8px} .radio-group label{display:flex;align-items:center;gap:6px;cursor:pointer}
  .resp-head{display:flex;align-items:center;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--line);margin-bottom:12px}
  .status{font-weight:700;padding:4px 10px;border-radius:6px;font-size:12px} .s-ok{background:rgba(24,128,56,.12);color:var(--green)} .s-err{background:rgba(217,48,37,.12);color:var(--red)} .s-info{background:rgba(26,115,232,.12);color:var(--accent)} .jk{color:#1967d2;font-weight:500} .js{color:#0d652d} .jn{color:#b06000} .jb{color:#7b1fa2} .jp{color:#5f6368}
  .resp-meta{color:var(--muted);font-size:12px} .resp-body{background:var(--bg3);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px;font-family:var(--mono);font-size:13px;white-space:pre-wrap;word-break:break-word;max-height:60vh;overflow:auto}
  .resp-tabs{display:flex;gap:4px;margin-bottom:8px} .resp-tab{padding:4px 10px;font-size:12px;border-radius:6px;color:var(--muted)} .resp-tab.active{background:var(--bg3);color:var(--text)}
  .modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.6);display:grid;place-items:center;z-index:50} .modal{background:var(--bg2);border:1px solid var(--line);border-radius:var(--radius);width:min(640px,92vw);max-height:85vh;overflow:auto;padding:20px;box-shadow:var(--shadow)}
  .modal h2{margin:0 0 12px;font-size:18px} .modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
  .env-editor .var-row{display:grid;grid-template-columns:1fr 1fr 36px;gap:8px;margin-bottom:8px}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--bg4);border:1px solid var(--line2);padding:10px 16px;border-radius:var(--radius-sm);z-index:100;box-shadow:var(--shadow)}
  .empty{color:var(--muted);text-align:center;padding:40px} .help{color:var(--muted);font-size:12px;line-height:1.6}
  @@media (max-width:820px){.layout{grid-template-columns:1fr}.sidebar{display:none}}
</style>
</head>
<body>
  <header class="topbar">
    <div class="logo">
      <svg class="logo-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="bwc-logo-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#1a73e8" />
            <stop offset="1" stop-color="#9334e6" />
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#bwc-logo-g)" />
        <path d="M7 8h4.5a2.5 2.5 0 0 1 0 5H7zm0 5h5.5a2.5 2.5 0 0 1 0 5H7z" fill="#fff" opacity=".95"/>
        <circle cx="18" cy="8" r="1.6" fill="#fff" />
        <circle cx="18" cy="18" r="1.6" fill="#fff" />
        <path d="M15.5 8h1m0 10h1" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <span class="logo-text"><span class="logo-strong">Build</span>Workflow Connect</span>
    </div>
    <input class="req-name" id="reqName" placeholder="Request name" />
    <div class="spacer"></div>
    <label style="color:var(--muted);font-size:12px">Environment</label>
    <select class="env-select" id="envSelect"></select>
    <button class="btn" id="envManageBtn">Manage</button>
    <button class="btn" id="saveBtn">Save</button>
    <button class="btn danger" id="resetAppBtn" title="Clear all saved data">Reset app</button>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="side-tabs">
        <button class="side-tab active" data-tab="coll">Collections</button>
        <button class="side-tab" data-tab="envs">Environments</button>
      </div>
      <div class="side-body" id="sideCollections">
        <div class="side-section">
          <div class="side-head">Groups <button class="add icon-btn" id="addGroupBtn">+</button></div>
          <div id="groupsList"></div>
        </div>
        <div class="side-section">
          <div class="side-head">Ungrouped <button class="add icon-btn" id="addUngroupedBtn">+</button></div>
          <div id="ungroupedList"></div>
        </div>
      </div>
      <div class="side-body" id="sideEnvs" style="display:none">
        <div class="side-section">
          <div class="side-head">Environments <button class="add icon-btn" id="addEnvBtn">+</button></div>
          <div id="envsList"></div>
        </div>
      </div>
    </aside>

    <main class="main" style="overflow:hidden;display:flex;flex-direction:column">
      <div class="req-bar">
        <select class="method-sel" id="methodSel">
          <option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option>
          <option>DELETE</option><option>OPTIONS</option><option>HEAD</option>
        </select>
        <input class="url-input" id="urlInput" placeholder="https://api.example.com/users/{{id}}" />
        <button class="send-btn" id="sendBtn">Send</button>
      </div>

      <div class="tabs" id="reqTabs">
        <button type="button" class="tab active" data-pane="params">Params</button>
        <button type="button" class="tab" data-pane="headers">Headers</button>
        <button type="button" class="tab" data-pane="body">Body</button>
        <button type="button" class="tab" data-pane="auth">Auth</button>
      </div>
      <div class="tab-content" style="flex:1;min-height:0;display:flex;flex-direction:column">
        <div class="pane active" id="pane-params">
          <table class="kv-table"><thead><tr><th>Key</th><th>Value</th><th></th></tr></thead><tbody id="paramsBody"></tbody></table>
          <button class="btn small-btn" id="addParamBtn" style="margin-top:8px">+ Add param</button>
        </div>
        <div class="pane" id="pane-headers">
          <table class="kv-table"><thead><tr><th>Key</th><th>Value</th><th></th></tr></thead><tbody id="headersBody"></tbody></table>
          <button class="btn small-btn" id="addHeaderBtn" style="margin-top:8px">+ Add header</button>
        </div>
        <div class="pane" id="pane-body">
          <div class="radio-group" id="bodyTypeGroup">
            <label><input type="radio" name="bodyType" value="none" checked> none</label>
            <label><input type="radio" name="bodyType" value="json"> JSON</label>
            <label><input type="radio" name="bodyType" value="text"> text</label>
            <label><input type="radio" name="bodyType" value="form"> form-urlencoded</label>
          </div>
          <textarea class="body-area" id="bodyArea" placeholder='{"key":"value"}'></textarea>
          <button class="btn small-btn" id="prettifyBtn" style="margin-top:8px">Prettify JSON</button>
        </div>
        <div class="pane" id="pane-auth">
          <div class="radio-group" id="authTypeGroup">
            <label><input type="radio" name="authType" value="none" checked> none</label>
            <label><input type="radio" name="authType" value="bearer"> Bearer token</label>
            <label><input type="radio" name="authType" value="basic"> Basic auth</label>
            <label><input type="radio" name="authType" value="apikey"> API Key</label>
          </div>
          <div id="authFields"></div>
        </div>
      </div>

      <div style="border-top:1px solid var(--line);padding:12px 16px;flex:0 0 auto">
        <div class="resp-head">
          <span class="tabs" style="border:0;padding:0">
            <div class="resp-tab active" data-resp="body">Body</div>
            <div class="resp-tab" data-resp="headers">Headers</div>
            <div class="resp-tab" data-resp="raw">Raw</div>
          </span>
          <span id="respStatus" class="status s-info">—</span>
          <span id="respMeta" class="resp-meta"></span>
        </div>
        <div id="respBodyView" class="resp-body">Send a request to see the response.</div>
        <div id="respHeadersView" class="resp-body" style="display:none"></div>
        <div id="respRawView" class="resp-body" style="display:none"></div>
      </div>
    </main>
  </div>

<script>
const state = { envs:[], groups:[], requests:[], activeReqId:null, activeEnvId:null, lastResp:null };

function uid(){ return Math.random().toString(36).slice(2)+Date.now().toString(36); }
async function api(path, opts={}) {
  const res = await fetch(path, { headers:{'Content-Type':'application/json'}, ...opts });
  if(!res.ok){ throw new Error(await res.text()); }
  if(res.status===204) return null;
  return res.json();
}

function nReq(r){ return {id:r.id,groupId:r.groupId,name:r.name,method:r.method,url:r.url,body:r.body,bodyType:r.bodyType,
  params: safeParse(r.paramsJson,'[]'), headers: safeParse(r.headersJson,'[]'), auth: safeParse(r.authJson,'{}') }; }
function safeParse(s,f){ try{return JSON.parse(s||f);}catch{return JSON.parse(f);} }

function normEnv(e){ return {id:e.id,name:e.name,variables:(e.variables||[]).map(v=>({key:v.key,value:v.value}))}; }

async function loadAll(){
  const [envs,groups,reqs] = await Promise.all([api('/api/environments'), api('/api/groups'), api('/api/requests')]);
  state.envs = envs.map(normEnv);
  state.groups = groups;
  state.requests = reqs.map(nReq);
  if(!state.envs.length){
    const e = await api('/api/environments',{method:'POST',body:JSON.stringify({name:'Default',variables:[]})});
    state.envs.push(normEnv(e));
  }
  state.activeEnvId = state.envs[0].id;
  renderAll();
}

// ---------- Render ----------
function renderAll(){ renderEnvs(); renderEnvSelect(); renderGroups(); renderUngrouped(); }
function renderEnvSelect(){
  const sel=document.getElementById('envSelect');
  sel.innerHTML=state.envs.map(e=>`<option value="${e.id}" ${e.id===state.activeEnvId?'selected':''}>${esc(e.name)}</option>`).join('');
}
function renderEnvs(){
  const list=document.getElementById('envsList');
  list.innerHTML=state.envs.map(e=>`<div class="env-item ${e.id===state.activeEnvId?'active':''}" data-id="${e.id}"><span style="flex:1">${esc(e.name)}</span><span style="color:var(--muted);font-size:11px">${(e.variables||[]).length} vars</span></div>`).join('');
  list.querySelectorAll('.env-item').forEach(el=>{
    el.onclick=()=>{ state.activeEnvId=+el.dataset.id; renderEnvs(); renderEnvSelect(); };
    el.ondblclick=()=>openEnvModal(+el.dataset.id);
  });
}
function renderGroups(){
  const list=document.getElementById('groupsList');
  list.innerHTML=state.groups.map(g=>{
    const reqs=state.requests.filter(r=>r.groupId===g.id);
    return `<div class="group" data-id="${g.id}">
      <div class="group-head"><span class="chev">▶</span><span style="flex:1" class="gname">${esc(g.name)}</span>
      <button class="icon-btn" data-act="addreq">+</button><button class="icon-btn" data-act="del">🗑</button></div>
      <div class="group-items">${reqs.map(r=>reqItemHtml(r)).join('') || '<div class="empty" style="padding:8px;font-size:12px">No requests</div>'}</div>
    </div>`;
  }).join('');
  list.querySelectorAll('.group').forEach(gEl=>{
    const head=gEl.querySelector('.group-head');
    head.onclick=(e)=>{ if(e.target.dataset.act) return; gEl.classList.toggle('open'); };
    gEl.querySelector('[data-act="addreq"]').onclick=(e)=>{e.stopPropagation();createRequest(gEl.dataset.id);};
    gEl.querySelector('[data-act="del"]').onclick=(e)=>{e.stopPropagation();deleteGroup(+gEl.dataset.id);};
    gEl.querySelectorAll('.req-item').forEach(ri=>{ ri.onclick=()=>loadRequest(+ri.dataset.id); });
  });
}
function renderUngrouped(){
  const list=document.getElementById('ungroupedList');
  const reqs=state.requests.filter(r=>!r.groupId);
  list.innerHTML=reqs.map(r=>reqItemHtml(r)).join('') || '<div class="empty" style="padding:8px;font-size:12px">No requests</div>';
  list.querySelectorAll('.req-item').forEach(ri=>{ ri.onclick=()=>loadRequest(+ri.dataset.id); });
}
function reqItemHtml(r){ return `<div class="req-item ${r.id===state.activeReqId?'active':''}" data-id="${r.id}"><span class="method-badge m-${r.method}">${r.method}</span><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.name||r.url||'Untitled')}</span></div>`; }
function esc(s){ return (s==null?'':String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ---------- CRUD ----------
async function createGroup(){
  const name=prompt('Group name'); if(!name) return;
  const g=await api('/api/groups',{method:'POST',body:JSON.stringify({name})});
  state.groups.push(g); renderAll();
}
async function deleteGroup(id){
  if(!confirm('Delete group and its requests?')) return;
  await api('/api/groups/'+id,{method:'DELETE'});
  state.groups=state.groups.filter(g=>g.id!==id);
  state.requests=state.requests.filter(r=>r.groupId!==id);
  if(state.activeReqId && !state.requests.find(r=>r.id===state.activeReqId)) resetRequest();
  renderAll();
}
async function createRequest(groupId){
  const r=await api('/api/requests',{method:'POST',body:JSON.stringify({groupId:groupId?+groupId:null,name:'New Request',method:'GET',url:'',body:'',bodyType:'none',headersJson:'[]',paramsJson:'[]',authType:'none',authJson:'{}'})});
  state.requests.push(nReq(r));
  loadRequest(r.id); renderAll();
}
async function saveCurrent(){
  const r=getActive(); if(!r) return;
  collectFromForm(r);
  r.name=document.getElementById('reqName').value || r.name || 'Untitled';
  const payload={id:r.id,groupId:r.groupId,name:r.name,method:r.method,url:r.url,body:r.body,bodyType:r.bodyType,
    headersJson:JSON.stringify(r.headers||[]),paramsJson:JSON.stringify(r.params||[]),authType:r.auth?.type||'none',authJson:JSON.stringify(r.auth||{type:'none'})};
  await api('/api/requests/'+r.id,{method:'PUT',body:JSON.stringify(payload)});
  toast('Saved'); renderAll();
}
function getActive(){ return state.requests.find(r=>r.id===state.activeReqId); }

function loadRequest(id){
  const r=state.requests.find(x=>x.id===id); if(!r) return;
  state.activeReqId=id;
  document.getElementById('reqName').value=r.name||'';
  document.getElementById('methodSel').value=r.method;
  document.getElementById('urlInput').value=r.url;
  document.getElementById('bodyArea').value=r.body||'';
  setRadio('bodyType', r.bodyType||'none');
  setRadio('authType', r.auth?.type||'none');
  kvRender('paramsBody', r.params||[]);
  kvRender('headersBody', r.headers||[]);
  renderAuthFields(r.auth||{type:'none'});
  renderAll();
  showRespPlaceholder();
}
function resetRequest(){
  state.activeReqId=null;
  document.getElementById('reqName').value='';
  document.getElementById('urlInput').value='';
  kvRender('paramsBody',[]);
  kvRender('headersBody',[]);
  document.getElementById('bodyArea').value='';
  showRespPlaceholder(); renderAll();
}
function collectFromForm(r){
  r.name=document.getElementById('reqName').value;
  r.method=document.getElementById('methodSel').value;
  r.url=document.getElementById('urlInput').value;
  r.params=kvCollect('paramsBody');
  r.headers=kvCollect('headersBody');
  r.body=document.getElementById('bodyArea').value;
  r.bodyType=getRadio('bodyType');
  r.auth=collectAuth();
}

// ---------- KV ----------
function kvRender(id,rows){
  const tb=document.getElementById(id);
  tb.innerHTML=(rows.length?rows:[{key:'',value:''}]).map(row=>`<tr><td><input class="kv-input" data-field="key" value="${esc(row.key)}" placeholder="key"/></td><td><input class="kv-input" data-field="value" value="${esc(row.value)}" placeholder="value"/></td><td><button class="icon-btn row-del">✕</button></td></tr>`).join('');
  attachKv(id);
}
function attachKv(id){
  const tb=document.getElementById(id);
  tb.querySelectorAll('.row-del').forEach(btn=>{ btn.onclick=()=>{ btn.closest('tr').remove(); if(!tb.querySelector('tr')) tb.innerHTML=`<tr><td><input class="kv-input" data-field="key" placeholder="key"/></td><td><input class="kv-input" data-field="value" placeholder="value"/></td><td><button class="icon-btn row-del">✕</button></td></tr>`; attachKv(id); }; });
}
function kvCollect(id){
  const tb=document.getElementById(id); const out=[];
  tb.querySelectorAll('tr').forEach(tr=>{
    const key=tr.querySelector('[data-field="key"]').value.trim();
    const val=tr.querySelector('[data-field="value"]').value;
    if(key) out.push({key,value:val});
  }); return out;
}
document.getElementById('addParamBtn').onclick=()=>{ const tb=document.getElementById('paramsBody'); tb.insertAdjacentHTML('beforeend',`<tr><td><input class="kv-input" data-field="key" placeholder="key"/></td><td><input class="kv-input" data-field="value" placeholder="value"/></td><td><button class="icon-btn row-del">✕</button></td></tr>`); attachKv('paramsBody'); };
document.getElementById('addHeaderBtn').onclick=()=>{ const tb=document.getElementById('headersBody'); tb.insertAdjacentHTML('beforeend',`<tr><td><input class="kv-input" data-field="key" placeholder="key"/></td><td><input class="kv-input" data-field="value" placeholder="value"/></td><td><button class="icon-btn row-del">✕</button></td></tr>`); attachKv('headersBody'); };
document.getElementById('prettifyBtn').onclick=()=>{ try { const v=document.getElementById('bodyArea').value; document.getElementById('bodyArea').value=JSON.stringify(JSON.parse(v),null,2); } catch(e){ toast('Invalid JSON: '+e.message);} };

// ---------- Auth ----------
function setRadio(name,val){ document.querySelectorAll(`input[name="${name}"]`).forEach(r=>{ if(r.value===val) r.checked=true; }); }
function getRadio(name){ return document.querySelector(`input[name="${name}"]:checked`)?.value; }
function renderAuthFields(auth){
  const el=document.getElementById('authFields');
  if(auth.type==='bearer') el.innerHTML=`<label>Token</label><input id="authToken" value="${esc(auth.token||'')}" style="width:100%;margin-top:6px" placeholder="{{token}}"/>`;
  else if(auth.type==='basic') el.innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><div><label>Username</label><input id="authUser" value="${esc(auth.username||'')}" style="width:100%;margin-top:6px"/></div><div><label>Password</label><input id="authPass" type="password" value="${esc(auth.password||'')}" style="width:100%;margin-top:6px"/></div></div>`;
  else if(auth.type==='apikey') el.innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><div><label>Key</label><input id="authKey" value="${esc(auth.key||'')}" style="width:100%;margin-top:6px"/></div><div><label>Value</label><input id="authVal" value="${esc(auth.value||'')}" style="width:100%;margin-top:6px"/></div></div><div style="margin-top:8px"><label>Add to</label><select id="authLoc" style="width:100%;margin-top:6px"><option value="header" ${auth.location==='header'?'selected':''}>Header</option><option value="query" ${auth.location==='query'?'selected':''}>Query params</option></select></div>`;
  else el.innerHTML='<div class="help">No authentication.</div>';
}
function collectAuth(){
  const type=getRadio('authType'); const auth={type};
  if(type==='bearer') auth.token=document.getElementById('authToken')?.value||'';
  else if(type==='basic'){ auth.username=document.getElementById('authUser')?.value||''; auth.password=document.getElementById('authPass')?.value||''; }
  else if(type==='apikey'){ auth.key=document.getElementById('authKey')?.value||''; auth.value=document.getElementById('authVal')?.value||''; auth.location=document.getElementById('authLoc')?.value||'header'; }
  return auth;
}
document.getElementById('authTypeGroup').addEventListener('change',()=>{
  const a={type:getRadio('authType')}; const r=getActive(); if(r) r.auth=a; renderAuthFields(a);
});

// ---------- Variables ----------
function currentEnv(){ return state.envs.find(e=>e.id===state.activeEnvId); }
function substitute(str){
  if(str==null) return str;
  const vars={}; (currentEnv()?.variables||[]).forEach(v=>{ if(v.key) vars[v.key]=v.value; });
  return String(str).replace(/\{\{\s*([\w.-]+)\s*\}\}/g,(_,k)=> (k in vars)? vars[k] : `{{${k}}}`);
}

// ---------- Send ----------
async function sendRequest(){
  const r=getActive() || {id:null,method:'GET',url:'',params:[],headers:[],body:'',bodyType:'none',auth:{type:'none'}};
  collectFromForm(r);
  const btn=document.getElementById('sendBtn'); btn.disabled=true; btn.textContent='Sending…';
  setResp('info','Sending…','','');
  const t0=performance.now();
  try{
    const resolvedUrl=substitute(r.url.trim());
    const params=(r.params||[]).map(p=>({key:substitute(p.key),value:substitute(p.value)}));
    if(r.auth?.type==='apikey' && r.auth.location==='query') params.push({key:substitute(r.auth.key),value:substitute(r.auth.value)});
    const headers=(r.headers||[]).map(h=>({key:substitute(h.key),value:substitute(h.value)}));
    if(r.auth?.type==='bearer' && r.auth.token) headers.push({key:'Authorization',value:'Bearer '+substitute(r.auth.token)});
    if(r.auth?.type==='basic') headers.push({key:'Authorization',value:'Basic '+btoa(substitute(r.auth.username)+':'+substitute(r.auth.password))});
    if(r.auth?.type==='apikey' && r.auth.location==='header' && r.auth.key) headers.push({key:substitute(r.auth.key),value:substitute(r.auth.value)});
    if(r.bodyType==='json' && !headers.some(h=>h.key.toLowerCase()==='content-type')) headers.push({key:'Content-Type',value:'application/json'});
    if(r.bodyType==='form' && !headers.some(h=>h.key.toLowerCase()==='content-type')) headers.push({key:'Content-Type',value:'application/x-www-form-urlencoded'});

    const payload={method:r.method,url:resolvedUrl,headers,params,body:substitute(r.body),bodyType:r.bodyType};
    const res=await api('/api/proxy/execute',{method:'POST',body:JSON.stringify(payload)});
    state.lastResp={status:res.status,statusText:res.statusText,headers:res.headers,raw:res.body,pretty:pretty(res.body),dur:res.durationMs,err:!!res.error};
    showResp();
  }catch(err){
    state.lastResp={status:0,statusText:String(err),headers:{},raw:String(err),pretty:String(err),dur:Math.round(performance.now()-t0),err:true};
    showResp();
  }finally{ btn.disabled=false; btn.textContent='Send'; }
}
function pretty(raw){ try{return JSON.stringify(JSON.parse(raw),null,2);}catch{return raw;} }
function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function highlightJson(raw){
  let text=raw; try{ text=JSON.stringify(JSON.parse(raw),null,2); }catch{}
  let s=escHtml(text);
  s=s.replace(/"(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?/g, (m)=>{
    return /:\s*$/.test(m.trim()) ? '<span class="jk">'+m+'</span>' : '<span class="js">'+m+'</span>';
  });
  s=s.replace(/\b(true|false|null)\b/g,'<span class="jb">$1</span>');
  s=s.replace(/-?\d+(\.\d+)?([eE][+-]?\d+)?/g,'<span class="jn">$&</span>');
  s=s.replace(/[{}[\],]/g,'<span class="jp">$&</span>');
  return s;
}
function setResp(cls,msg){ const s=document.getElementById('respStatus'); s.className='status '+cls; s.textContent=msg; document.getElementById('respMeta').textContent=''; }
function showResp(){
  const d=state.lastResp; if(!d) return;
  const s=document.getElementById('respStatus'); const ok=d.status>=200&&d.status<300;
  s.className='status '+(d.err?'s-err':(ok?'s-ok':'s-err'));
  s.textContent=d.err?'Error':`${d.status} ${d.statusText}`;
  document.getElementById('respMeta').textContent=`${d.dur?.toFixed?.(0)??''} ms`;
  document.getElementById('respBodyView').innerHTML=highlightJson(d.pretty||d.raw||'');
  document.getElementById('respHeadersView').textContent=Object.entries(d.headers||{}).map(([k,v])=>`${k}: ${v}`).join('\n');
  document.getElementById('respRawView').textContent=d.raw||'';
}
function showRespPlaceholder(){ document.getElementById('respBodyView').textContent='Send a request to see the response.'; }

// tabs
document.querySelectorAll('#reqTabs .tab').forEach(t=>{ t.onclick=()=>{ document.querySelectorAll('#reqTabs .tab').forEach(x=>x.classList.remove('active')); t.classList.add('active'); document.querySelectorAll('#pane-params,#pane-headers,#pane-body,#pane-auth').forEach(p=>p.classList.remove('active')); document.getElementById('pane-'+t.dataset.pane).classList.add('active'); }; });
document.querySelectorAll('.resp-tab').forEach(t=>{ t.onclick=()=>{ document.querySelectorAll('.resp-tab').forEach(x=>x.classList.remove('active')); t.classList.add('active'); const v=t.dataset.resp; document.getElementById('respBodyView').style.display=v==='body'?'block':'none'; document.getElementById('respHeadersView').style.display=v==='headers'?'block':'none'; document.getElementById('respRawView').style.display=v==='raw'?'block':'none'; }; });
document.querySelectorAll('.side-tab').forEach(t=>{ t.onclick=()=>{ document.querySelectorAll('.side-tab').forEach(x=>x.classList.remove('active')); t.classList.add('active'); document.getElementById('sideCollections').style.display=t.dataset.tab==='coll'?'block':'none'; document.getElementById('sideEnvs').style.display=t.dataset.tab==='envs'?'block':'none'; }; });

// topbar
document.getElementById('envSelect').onchange=e=>{ state.activeEnvId=+e.target.value; renderEnvs(); };
document.getElementById('saveBtn').onclick=saveCurrent;
document.getElementById('sendBtn').onclick=sendRequest;
document.getElementById('addGroupBtn').onclick=createGroup;
document.getElementById('addUngroupedBtn').onclick=()=>createRequest(null);
document.getElementById('addEnvBtn').onclick=()=>openEnvModal(null);
document.getElementById('envManageBtn').onclick=()=>openEnvModal(state.activeEnvId);
document.getElementById('resetAppBtn').onclick=openResetModal;

// Env modal
function openEnvModal(id){
  const env = id ? state.envs.find(e=>e.id===id) : null;
  const isNew=!env; const e=env||{id:null,name:'New Environment',variables:[]};
  const backdrop=document.createElement('div'); backdrop.className='modal-backdrop';
  backdrop.innerHTML=`<div class="modal env-editor"><h2>${isNew?'New':'Edit'} Environment</h2><label>Name</label><input id="envName" value="${esc(e.name)}" style="width:100%;margin:6px 0 12px"/><label>Variables</label><div id="varRows"></div><button class="btn small-btn" id="addVarBtn" style="margin-top:6px">+ Add variable</button><div class="actions">${!isNew?`<button class="btn danger" id="delEnvBtn">Delete</button>`:''}<button class="btn" id="cancelEnvBtn">Cancel</button><button class="btn primary" id="saveEnvBtn">Save</button></div></div>`;
  document.body.appendChild(backdrop);
  const rowsEl=backdrop.querySelector('#varRows');
  function renderVars(vars){ rowsEl.innerHTML=(vars.length?vars:[{key:'',value:''}]).map(v=>`<div class="var-row"><input placeholder="key" value="${esc(v.key)}" data-f="key"/><input placeholder="value" value="${esc(v.value)}" data-f="value"/><button class="icon-btn row-del">✕</button></div>`).join(''); rowsEl.querySelectorAll('.row-del').forEach(b=>b.onclick=()=>{b.parentElement.remove(); if(!rowsEl.querySelector('.var-row')) renderVars([]);}); }
  renderVars(e.variables||[]);
  backdrop.querySelector('#addVarBtn').onclick=()=>{ rowsEl.insertAdjacentHTML('beforeend',`<div class="var-row"><input placeholder="key" data-f="key"/><input placeholder="value" data-f="value"/><button class="icon-btn row-del">✕</button></div>`); rowsEl.querySelector('.var-row:last-child .row-del').onclick=function(){this.parentElement.remove();}; };
  backdrop.querySelector('#cancelEnvBtn').onclick=()=>backdrop.remove();
  backdrop.querySelector('#saveEnvBtn').onclick=async()=>{
    const name=backdrop.querySelector('#envName').value.trim()||'Untitled';
    const vars=[]; rowsEl.querySelectorAll('.var-row').forEach(row=>{ const k=row.querySelector('[data-f="key"]').value.trim(); const v=row.querySelector('[data-f="value"]').value; if(k) vars.push({key:k,value:v}); });
    const payload={name,variables:vars.map(v=>({key:v.key,value:v.value}))};
    try{
      if(isNew){
        const ne=await api('/api/environments',{method:'POST',body:JSON.stringify(payload)});
        state.envs.push(normEnv(ne));
        state.activeEnvId=ne.id;
      } else {
        const ne=await api('/api/environments/'+e.id,{method:'PUT',body:JSON.stringify(payload)});
        const i=state.envs.findIndex(x=>x.id===e.id); if(i>=0) state.envs[i]=normEnv(ne);
      }
      backdrop.remove(); renderAll();
    }catch(err){ toast('Save failed: '+err.message); }
  };
  const delBtn=backdrop.querySelector('#delEnvBtn');
  if(delBtn) delBtn.onclick=async()=>{
    if(state.envs.length<=1){ toast('Keep at least one environment'); return; }
    if(!confirm('Delete environment?')) return;
    await api('/api/environments/'+e.id,{method:'DELETE'});
    state.envs=state.envs.filter(x=>x.id!==e.id);
    if(state.activeEnvId===e.id) state.activeEnvId=state.envs[0].id;
    backdrop.remove(); renderAll();
  };
}

function openResetModal(){
  const backdrop=document.createElement('div'); backdrop.className='modal-backdrop';
  backdrop.innerHTML=`<div class="modal"><h2>Reset app</h2><p class="help">This permanently deletes all environments, groups, and requests. Enter the reset password from appsettings.json to continue.</p><label>Password</label><input id="resetPasswordInput" type="password" style="width:100%;margin:6px 0 12px" /><div class="actions"><button class="btn" id="cancelResetBtn">Cancel</button><button class="btn danger" id="confirmResetBtn">Reset everything</button></div></div>`;
  document.body.appendChild(backdrop);
  const pwdInput=backdrop.querySelector('#resetPasswordInput');
  pwdInput.focus();
  backdrop.querySelector('#cancelResetBtn').onclick=()=>backdrop.remove();
  backdrop.querySelector('#confirmResetBtn').onclick=async()=>{
    const btn=backdrop.querySelector('#confirmResetBtn');
    btn.disabled=true; btn.textContent='Resetting…';
    try{
      await api('/api/admin/reset',{method:'POST',body:JSON.stringify({password:pwdInput.value})});
      toast('App reset');
      backdrop.remove();
      state.activeReqId=null;
      await loadAll();
    }catch(err){
      toast('Reset failed: '+err.message);
    }finally{
      btn.disabled=false; btn.textContent='Reset everything';
    }
  };
  backdrop.addEventListener('keydown',e=>{ if(e.key==='Escape') backdrop.remove(); });
  backdrop.addEventListener('click',e=>{ if(e.target===backdrop) backdrop.remove(); });
}
function toast(msg){ const t=document.createElement('div'); t.className='toast'; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2500); }

loadAll().catch(e=>{ document.body.innerHTML='<pre>'+e+'</pre>'; });
</script>
